# Copy this file to .env (next to pom.xml) and fill it in. Never commit .env.
# Put comments on their own lines: a comment after a value becomes part of the value.

# PostgreSQL on this PC. Create an empty database named kaaj once (pgAdmin or psql).
DB_PASSWORD=your-postgres-password
DB_NAME=kaaj
DB_USER=postgres

# The first admin account, created when the backend starts and no admin exists yet
KAAJ_ADMIN_EMAIL=admin@kaaj.local
KAAJ_ADMIN_PASSWORD=Admin@12345

# Free AI (optional). The job-post assistant and the AI scam check use them; without keys they fall back
# to templates and rules. Gemini: a free key from https://aistudio.google.com (Get API key). Groq: a free key
# from https://console.groq.com. If Google retires the model below, put the current Flash model's name here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Used by teammates' features later
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_APP_PASSWORD=
KAAJ_CODE_SECRET=
