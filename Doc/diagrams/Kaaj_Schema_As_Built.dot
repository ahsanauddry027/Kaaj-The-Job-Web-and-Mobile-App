digraph kaaj {
graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.6, forcelabels=true, fontname="Helvetica", labelloc=t, fontsize=26, label=<<B>Kaaj – The Job · database schema as built</B><BR/><FONT POINT-SIZE="14">PostgreSQL · Flyway migrations V1–V3, V130, V140, V150, V160, V240 · Spring Boot backend shared by the web and Android apps<BR/>Crow-foot end = the many side; each line is labelled with its foreign-key column</FONT>>];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [color="#64748B", arrowhead=tee, arrowtail=crow, dir=both, penwidth=1.3];
subgraph cluster_0 { label=<<B>Shared setup (identity, taxonomy, audit)</B>>; fontsize=15; style="rounded,filled"; fillcolor="#EFF6FF"; color="#1D4ED8";
